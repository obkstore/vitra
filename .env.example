# Copy this file to .env and fill in your values. Never commit .env to version control.

# AI provider configuration — keys MUST stay server-side.
# Use AI_PROVIDER=gemini or AI_PROVIDER=mock.
AI_PROVIDER=gemini
# Set the selected provider key in the local server/Vercel environment.
# Never prefix any secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# App Configuration
VITE_APP_NAME=HealthPlan AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Auth / MongoDB (server-side only — never prefix secrets with VITE_)
MONGODB_URI=mongodb://127.0.0.1:27017/healthplan
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=5000

# Password reset email (Gmail SMTP — server-side only)
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=